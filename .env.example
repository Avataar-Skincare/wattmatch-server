PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wattmatch
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP expiry, in seconds
OTP_TTL_SECONDS=600

# Fast2SMS (DLT-registered sender ID/template for Wattmatch's own account)
OTP_SMS_API_KEY=
OTP_SMS_SENDER_ID=
OTP_SMS_TEMPLATE_ID=

# SMTP (email OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reverse-auction PoC (see AUCTION_MVP_PLAN.md) — signs generator join tokens. Never commit a
# real value; generate a long random string per environment. This is the local-dev/fallback path —
# in production (NODE_ENV=production), set AUCTION_JWT_SECRET_ARN instead (see lib/secrets.ts) to
# fetch this from AWS Secrets Manager; leave this env var unset there so the real secret never sits
# in plain deployment config at all. If Secrets Manager is unreachable, this env var (if set) is
# still used as a fallback — set both in production for that reason, not just the ARN.
AUCTION_JWT_SECRET=
AUCTION_JWT_SECRET_ARN=

# Keys the HMAC used to pseudonymize bidder IPs for collusion detection (auctionTokens.ts's
# hashIp) — an HMAC secret, not a bare SHA-256 hash, because the IPv4 address space (~4.3 billion
# values) is small enough that a bare hash is fully reversible via a precomputed table. Same
# local-dev/Secrets-Manager fallback pattern as AUCTION_JWT_SECRET above.
IP_HASH_HMAC_SECRET=
IP_HASH_HMAC_SECRET_ARN=

# Dedicated DB user for the audit-bid write path, granted SELECT+INSERT only on
# wattmatch_auction_bids (no UPDATE/DELETE, no access to any other table) — so an application bug
# or injection reachable through the app's normal DB credentials still can't tamper with the
# tamper-evidence log. Create via: CREATE USER 'wattmatch_audit'@'%' IDENTIFIED BY '...';
# GRANT SELECT, INSERT ON <db>.wattmatch_auction_bids TO 'wattmatch_audit'@'%';
AUDIT_DB_USER=wattmatch_audit
AUDIT_DB_PASSWORD=

# Field-level encryption for auction participant identity data (see
# LIVE_AUCTION_IDENTITY_ENCRYPTION_PLAN.md) — never commit a real value. Local-dev/fallback path:
# generate with `openssl rand -base64 32`. In production, set FIELD_ENCRYPTION_KMS_KEY_ID instead
# (a KMS key ARN/alias) to encrypt/decrypt via AWS KMS directly; leave this env var unset there.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KMS_KEY_ID=
