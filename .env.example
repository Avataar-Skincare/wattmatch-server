PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wattmatch
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP expiry, in seconds
OTP_TTL_SECONDS=600

# Fast2SMS (DLT-registered sender ID/template for Wattmatch's own account)
OTP_SMS_API_KEY=
OTP_SMS_SENDER_ID=
OTP_SMS_TEMPLATE_ID=

# SMTP (email OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reverse-auction PoC (see AUCTION_MVP_PLAN.md) — signs generator join tokens. Never commit a
# real value; generate a long random string per environment. This is the local-dev/fallback path —
# in production (NODE_ENV=production), set AUCTION_JWT_SECRET_ARN instead (see lib/secrets.ts) to
# fetch this from AWS Secrets Manager; leave this env var unset there so the real secret never sits
# in plain deployment config at all. If Secrets Manager is unreachable, this env var (if set) is
# still used as a fallback — set both in production for that reason, not just the ARN.
AUCTION_JWT_SECRET=
AUCTION_JWT_SECRET_ARN=

# Keys the HMAC used to pseudonymize bidder IPs for collusion detection (auctionTokens.ts's
# hashIp) — an HMAC secret, not a bare SHA-256 hash, because the IPv4 address space (~4.3 billion
# values) is small enough that a bare hash is fully reversible via a precomputed table. Same
# local-dev/Secrets-Manager fallback pattern as AUCTION_JWT_SECRET above.
IP_HASH_HMAC_SECRET=
IP_HASH_HMAC_SECRET_ARN=

# Dedicated DB user for the audit-bid write path, granted SELECT+INSERT only on
# wattmatch_auction_bids (no UPDATE/DELETE, no access to any other table) — so an application bug
# or injection reachable through the app's normal DB credentials still can't tamper with the
# tamper-evidence log. Create via: CREATE USER 'wattmatch_audit'@'%' IDENTIFIED BY '...';
# GRANT SELECT, INSERT ON <db>.wattmatch_auction_bids TO 'wattmatch_audit'@'%';
AUDIT_DB_USER=wattmatch_audit
AUDIT_DB_PASSWORD=

# Field-level encryption for auction participant identity data (see
# LIVE_AUCTION_IDENTITY_ENCRYPTION_PLAN.md) — never commit a real value. Local-dev/fallback path:
# generate with `openssl rand -base64 32`. In production, set FIELD_ENCRYPTION_KMS_KEY_ID instead
# (a KMS key ARN/alias) to encrypt/decrypt via AWS KMS directly; leave this env var unset there.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KMS_KEY_ID=

# Razorpay — RAZORPAY_KEY_ID is a public identifier (safe to send to the frontend), so it's a plain
# env var, not run through Secrets Manager. RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET ARE
# secrets — same local-dev/Secrets-Manager fallback pattern as everything else above. Test and live
# mode use SEPARATE webhook secrets — re-set RAZORPAY_WEBHOOK_SECRET when switching modes, don't
# assume it carries over.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_KEY_SECRET_ARN=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_ARN=
CURRENCY=INR

# AWS ecosystem (see TENDER_WORKFLOW_STAKEHOLDER_PLAN.md's Tech Stack section). All AWS clients in
# this codebase (Secrets Manager, KMS, S3, SES) use the SDK's default credential provider chain —
# an IAM role in production, whatever's configured locally (`aws configure` / AWS_PROFILE) for
# dev/testing. No access-key env vars needed or wanted here; set them only via the AWS CLI's own
# config, never in this file.
AWS_REGION=ap-south-1

# File storage — leave AWS_S3_BUCKET unset for local dev; every upload/signed-URL call
# transparently falls back to a local directory instead (see lib/s3.ts). Set it in production to
# switch to real S3 with no other code change. Optional: AWS_S3_KMS_KEY_ID for a specific SSE-KMS
# key (falls back to the bucket's default KMS key if unset).
AWS_S3_BUCKET=
AWS_S3_KMS_KEY_ID=
LOCAL_STORAGE_DIR=./local-storage
PUBLIC_API_URL=http://localhost:4000

# Email delivery — defaults to the existing SMTP setup above. Set EMAIL_PROVIDER=ses once AWS SES
# production access is granted (new SES accounts start in sandbox mode) and SES_FROM_EMAIL is a
# domain-verified sender — every sendXxxEmail call switches transport with no other code change.
EMAIL_PROVIDER=smtp
SES_FROM_EMAIL=
EMAIL_FROM=

# GST invoicing (Red Flag #6) — Wattmatch does not yet hold a GSTIN (see PricingPage.tsx's own
# note). Leaving WATTMATCH_GSTIN unset generates a clearly-labeled provisional receipt with no tax
# charged for every paid fee; setting it after GST registration makes every subsequently generated
# document a real tax invoice automatically, no code change required. Never fill these with
# placeholder/fabricated values — leave blank until the real registration exists.
WATTMATCH_LEGAL_NAME=
WATTMATCH_GSTIN=
WATTMATCH_REGISTERED_ADDRESS=
WATTMATCH_GST_RATE_PERCENT=18
