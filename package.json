{
  "name": "wattmatch-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migration:generate": "sequelize-cli migration:generate --name",
    "webhook:captured": "node scripts/fakeWebhook.mjs payment.captured",
    "webhook:failed": "node scripts/fakeWebhook.mjs payment.failed",
    "webhook:invalid": "node scripts/fakeWebhook.mjs payment.captured"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@aws-sdk/client-ses": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.10",
    "multer": "^2.2.0",
    "mysql2": "^3.11.4",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "rate-limiter-flexible": "^11.2.0",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.5",
    "shamir-secret-sharing": "^0.0.4",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "^6.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
